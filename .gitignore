# ============================================================
# Unreal Engine 生成的文件 / 构建产物（不应提交）
# ============================================================
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/

# 以后添加插件时，插件内的构建产物也不要提交
Plugins/*/Binaries/
Plugins/*/DerivedDataCache/
Plugins/*/Intermediate/
Plugins/*/Saved/

# ============================================================
# Visual Studio 生成的项目文件与个人配置
# （由 Unreal 的 Generate Project Files 重新生成）
# ============================================================
.vs/
.idea/
*.sln
*.sln.DotSettings.user
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.db-shm
*.VC.db-wal
*.VC.opendb
*.user
*.userprefs
*.ipch
ipch/
*.log

# ============================================================
# 系统 / 临时文件
# ============================================================
.DS_Store
Thumbs.db
*.tmp
*.bak
